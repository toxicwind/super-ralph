# super-ralph runtime environment — copy to .env and fill in. .env is gitignored, never commit it.
# The CLI prefers FLOCK_API_KEY, then the deprecated NIM_PROXY_API_KEY, then provider keys.
# Every model call routes through the proxy by default; keys stay in env, never written to disk.

# Primary: Flock API key (preferred). Required for real runs.
FLOCK_API_KEY=

# Deprecated fallback (still honored — prefer FLOCK_API_KEY).
NIM_PROXY_API_KEY=

# Proxy base URL override (default is whatever the CLI resolves).
NIM_BASE_URL=

# Set to 1 to bypass the proxy entirely (direct provider behavior). Not recommended.
NIM_PROXY_BYPASS=
